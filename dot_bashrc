if command -v tput >/dev/null 2>&1; then
  red=$(tput setaf 1)
  green=$(tput setaf 2)
  blue=$(tput setaf 4)
  reset=$(tput sgr0)
  bold=$(tput bold)
fi

if [ -n "$CONTAINER_ID" ]; then
  # Customise PS1 for distrobox
  PS1='📦\[$green\][\u@$CONTAINER_ID:\[$bold\]\w\[$reset\]\[$green\]]\$\[$reset\] '
else
  PS1='\[$green\]\u@\h:\[$bold\]\w\[$reset\]\[$green\]\$\[$reset\] '
  eval "$(zoxide init bash)"
fi

# Set up fzf key bindings and fuzzy completion
eval "$(fzf --bash)"

# Only trigger if:
# - 'nushell' is not the parent process of this shell
# - We did not call: bash -c '...'
# - The fish binary exists and is executable
# TODO: Needs to not be associated with GUIX only.
if [[ $(ps --no-header --pid=$PPID --format=comm) != "nu" && -z ${BASH_EXECUTION_STRING} && -x "$HOME/.guix-home/profile/bin/nu" ]]; then
  shopt -q login_shell && LOGIN_OPTION='--login' || LOGIN_OPTION=''
  exec nu $LOGIN_OPTION
fi
